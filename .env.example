# Copy to backend/.env for local development. On Render set these in Dashboard > Environment.
# Placeholders only. Never commit real values.

# --- MongoDB Atlas ---
MONGODB_URL=mongodb+srv://<db_user>:<url_encoded_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=book_my_match

# --- Auth (keep your EXISTING SECRET_KEY on Render so already-issued login tokens stay valid) ---
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS: browser origins allowed to call the API (comma separated, no trailing slash) ---
CORS_ORIGINS=https://your-app.vercel.app
# Optional: also allow Vercel preview URLs, e.g.  https://your-app-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# --- Pricing (percent). Backend is the only source of truth. ---
FEE_PERCENT=2
TICKET_TAX_PERCENT=18
FOOD_TAX_PERCENT=5
# Optional food service fee, percent of the food subtotal (tax is then charged on subtotal + fee). 0 = no fee.
FOOD_FEE_PERCENT=0
MAX_TICKETS_PER_BOOKING=10
CANCEL_CUTOFF_HOURS=24

# --- Demo payments, tickets, entry (all optional) ---
RESERVATION_MINUTES=10
PAYMENTS_DEMO_ENABLED=true
# selectable | success | failure | random
DEMO_PAYMENT_MODE=selectable
DEMO_PAYMENT_SUCCESS_RATE=0.8
# Keep stable! Changing it invalidates already-issued QR codes. Leave empty to use SECRET_KEY.
TICKET_SIGNING_KEY=
ENFORCE_ENTRY_DATE=false
# Venue-local timezone for match times, expiry and cancellation cutoff
APP_TIMEZONE=Asia/Kolkata

# --- Phase 3A seating limits (optional; defaults shown). Protect a free Atlas cluster from accidental huge layouts. ---
SEATING_MAX_SEATS_PER_LAYOUT=60000
SEATING_MAX_SEATS_PER_ROW=500

# --- Used only by `python -m app.create_admin` ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Used only by `python -m app.migrate_to_mongo` (the OLD database; read-only) ---
# SOURCE_DATABASE_URL=sqlite:///./book_my_match.db
# SOURCE_DATABASE_URL=postgresql://user:password@host:5432/dbname
